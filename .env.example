# Public Stripe publishable key (pk_live_... or pk_test_...)
stripe_api=

# Secret Stripe API key (sk_live_... or sk_test_...); server-side only
stripe_live=

# SMTP server hostname (e.g. smtp.example.com)
smtp_server=

# SMTP username
smtp_user=

# SMTP password
smtp_passwort=

# Stripe webhook signing secret (from the Stripe Dashboard / `stripe listen`), whsec_...
STRIPE_WEBHOOK_SECRET=

# Postgres connection string (Vercel Postgres / Neon). Required for orders, idempotency and logs.
DATABASE_URL=

# Admin area (single shared password)
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Kennzeichen-Services Dropshipping API (client 105, DEV: api.kennzeichen.dev)
KENNZEICHEN_API_HOST=api.kennzeichen.dev
KENNZEICHEN_API_CLIENT_ID=105
KENNZEICHEN_API_VERSION=2.2.0
KENNZEICHEN_API_USERNAME=
KENNZEICHEN_API_PASSWORD=
KENNZEICHEN_API_TIMEOUT_SECONDS=55

# HMAC secret for verifying manufacturer webhook signatures (X-Signature)
KENNZEICHEN_WEBHOOK_SECRET=
